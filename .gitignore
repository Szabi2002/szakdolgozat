# ================================
# Root Level .gitignore
# Közlekedési Jegykezelő Rendszer
# ================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
**/.env
**/.env.local

# Build Outputs
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
*.tsbuildinfo

# IDE and Editors
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# Testing
coverage/
*.lcov
.nyc_output/
junit.xml
test-results/
playwright-report/
test-results.xml

# Temporary Files
*.tmp
*.temp
.tmp/
tmp/
temp/

# Database
*.db
*.sqlite
*.sqlite3

# Secrets and Credentials
*.pem
*.key
*.cert
credentials.json
service-account.json

# Generated Documentation
docs/api-generated/
docs/.vuepress/dist

# Backup Files (prevent accidental commits)
*.bak
*.backup
*.backup*
*.old
*.original
*.save
*~
